{
	"name": "@angry-carp/checks",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		"./email-links": {
			"types": "./dist/email-links/extract-links.d.ts",
			"default": "./dist/email-links/extract-links.js"
		},
		"./brands": {
			"types": "./dist/brands/brand-directory.d.ts",
			"default": "./dist/brands/brand-directory.js"
		},
		"./brands/local": {
			"types": "./dist/brands/load-directory.d.ts",
			"default": "./dist/brands/load-directory.js"
		},
		"./lookalikes": {
			"types": "./dist/lookalikes/compare-domains.d.ts",
			"default": "./dist/lookalikes/compare-domains.js"
		},
		"./dns": {
			"types": "./dist/lookups/dns.d.ts",
			"default": "./dist/lookups/dns.js"
		},
		"./rdap": {
			"types": "./dist/lookups/rdap.d.ts",
			"default": "./dist/lookups/rdap.js"
		},
		"./ip-rdap": {
			"types": "./dist/lookups/ip-rdap.d.ts",
			"default": "./dist/lookups/ip-rdap.js"
		},
		"./text-reuse": {
			"types": "./dist/text-reuse/winnowing.d.ts",
			"default": "./dist/text-reuse/winnowing.js"
		},
		"./reporting": {
			"types": "./dist/reporting/channels.d.ts",
			"default": "./dist/reporting/channels.js"
		},
		"./email-analysis": {
			"types": "./dist/email-analysis/analyze-email.d.ts",
			"default": "./dist/email-analysis/analyze-email.js"
		},
		"./email-analysis/output": {
			"types": "./dist/email-analysis/analysis-output.d.ts",
			"default": "./dist/email-analysis/analysis-output.js"
		},
		"./node/read-input": {
			"types": "./dist/node/read-input.d.ts",
			"default": "./dist/node/read-input.js"
		},
		"./reporting/preparation": {
			"types": "./dist/reporting/report-preparation.d.ts",
			"default": "./dist/reporting/report-preparation.js"
		},
		"./assessment-instructions": "./instructions/phishing-assessment.md"
	},
	"files": [
		"dist",
		"reference-data",
		"instructions"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"test": "node --test",
		"check:types": "tsc --noEmit",
		"brands:check": "node dist/brands/check-directory.js"
	},
	"dependencies": {
		"@moderation-api/unicode-spoofing": "0.4.0",
		"@zone-eu/mailsplit": "5.4.17",
		"email-addresses": "5.0.0",
		"parse5": "8.0.1",
		"tldts": "7.4.14",
		"valibot": "1.5.0"
	}
}
