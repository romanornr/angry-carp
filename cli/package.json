{
	"name": "@angry-carp/cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"resources"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node build-resources.mjs",
		"analyze": "node dist/main.js analyze",
		"extract:links": "node dist/main.js extract-links",
		"test": "node --test",
		"check:types": "tsc --noEmit"
	},
	"dependencies": {
		"@angry-carp/checks": "0.1.0"
	},
	"bin": {
		"angry-carp": "dist/main.js"
	}
}
